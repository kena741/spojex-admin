# Same Supabase project as spojext_superapp/apps/host/.env
NEXT_PUBLIC_SUPABASE_URL=https://xfwgeoqlsutzelhccwyx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Needed to update rows owned by other users (RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Cloud Messaging — same project as the Flutter app (spojex-4ddef).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Option A (local): save the downloaded JSON in the admin root:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B (Vercel / production): paste minified JSON on one line, same as ICare MC admin:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"spojex-4ddef",...}

# Google Maps / Places — same key as Lolelink admin (stadium map pin).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
