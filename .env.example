# Spojex REST API — same base URL as spojext_superapp/apps/host/.env
# Copy SPOJEX_API_BASE_URL from the host app (no API key required).
SPOJEX_API_BASE_URL=https://spojex-backend-prod-576757759417.europe-west3.run.app
NEXT_PUBLIC_SPOJEX_API_BASE_URL=https://spojex-backend-prod-576757759417.europe-west3.run.app

# Firebase Cloud Messaging — same project as the Flutter app (spojex-4ddef).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Option A (local): save the downloaded JSON in the admin root:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B (Vercel / production): paste minified JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"spojex-4ddef",...}

# Google Maps / Places — stadium map pin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
